# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_ACCESS_TOKEN: Secret token required to unlock the private /staff-portal
# pre-opening administration view. Never expose this in frontend code.
ADMIN_ACCESS_TOKEN=""

# Future Production Integrations (Pre-Opening Roadmap)
# Transactional Email (for info@maisonhaven.com notifications)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Payment Gateway (for 100% upfront bookings upon official launch)
PAYSTACK_SECRET_KEY=""
